<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_nifty_search" model="ir.ui.view">
        <field name="name">project.nifty.search</field>
        <field name="model">project.nifty</field>
        <field name="arch" type="xml">
            <search string="Projects">
                <field name="name"/>
                <field name="department_manager_id"/>
                <field name="manager_id"/>
                <field name="member_ids"/>
                <filter name="status_not_started" string="Đang chuẩn bị" domain="[('status', '=', 'not_started')]"/>
                <filter name="status_in_progress" string="Đang thực hiện" domain="[('status', '=', 'in_progress')]"/>
                <filter name="status_pending_approval" string="Chờ duyệt hoàn thành" domain="[('status', '=', 'pending_approval')]"/>
                <filter name="status_finished" string="Hoàn thành" domain="[('status', '=', 'finished')]"/>
                <filter name="status_cancelled" string="Đã hủy" domain="[('status', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>

    <record id="view_project_nifty_tree" model="ir.ui.view">
        <field name="name">project.nifty.tree</field>
        <field name="model">project.nifty</field>
        <field name="arch" type="xml">
            <tree string="Projects">
                <field name="color" widget="color_picker"/>
                <field name="name"/>
                <field name="department_manager_id"/>
                <field name="manager_id" string="Team Leader"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status" widget="badge"/>
                <field name="progress" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <record id="view_project_nifty_kanban" model="ir.ui.view">
        <field name="name">project.nifty.kanban</field>
        <field name="model">project.nifty</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile project_nifty_kanban" create="1" quick_create="0">
                <field name="name"/>
                <field name="department_manager_id"/>
                <field name="manager_id"/>
                <field name="member_ids"/>
                <field name="status"/>
                <field name="progress"/>
                <field name="total_task_count"/>
                <field name="approved_task_count"/>
                <field name="member_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record project_nifty_card">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="mb-1">
                                    <span class="me-2">Department Manager:</span>
                                    <field name="department_manager_id"/>
                                </div>
                                <div class="mb-1">
                                    <span class="me-2">Team Leader:</span>
                                    <field name="manager_id"/>
                                </div>
                                <div class="mb-1">
                                    <field name="status" widget="badge"/>
                                </div>
                                <div class="mb-1">
                                    <span>Progress:</span>
                                    <field name="progress" widget="progressbar"/>
                                </div>
                                <div>
                                    <span>Tasks: </span><field name="approved_task_count"/>/<field name="total_task_count"/>
                                </div>
                                <div>
                                    <span>Members: </span><field name="member_count"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_project_nifty_form" model="ir.ui.view">
        <field name="name">project.nifty.form</field>
        <field name="model">project.nifty</field>
        <field name="arch" type="xml">
            <form string="Project" class="project_nifty_form">
                <header>
                    <field name="is_department_manager_user" invisible="1"/>
                    <field name="is_team_leader_user" invisible="1"/>
                    <field name="can_submit_completion_request" invisible="1"/>
                    <button name="action_submit_completion_request" type="object" string="Submit Completion Request" class="btn-primary" attrs="{'invisible': ['|', ('can_submit_completion_request', '=', False), ('status', 'in', ('pending_approval', 'finished', 'cancelled'))]}"/>
                    <button name="action_department_manager_finish" type="object" string="Xác nhận hoàn thành" class="btn-success" attrs="{'invisible': ['|', ('is_department_manager_user', '=', False), ('status', '!=', 'pending_approval')]}"/>
                    <button name="action_department_manager_cancel" type="object" string="Cancel Project" class="btn-danger" attrs="{'invisible': [('is_department_manager_user', '=', False)]}"/>
                    <field name="status" widget="statusbar" statusbar_visible="not_started,in_progress,pending_approval,finished,cancelled" attrs="{'readonly': ['&amp;', ('id', '!=', False), ('is_department_manager_user', '=', False)]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_tasklists" class="oe_stat_button" icon="fa-list-ul">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="tasklist_count"/></span>
                                <span class="o_stat_text">Task Lists</span>
                            </div>
                        </button>
                        <button type="object" name="action_open_tasks" class="oe_stat_button" icon="fa-tasks">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="total_task_count"/></span>
                                <span class="o_stat_text">Tasks</span>
                            </div>
                        </button>
                        <button type="object" name="action_open_documents" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="document_count"/></span>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                        <button type="object" name="action_open_files" class="oe_stat_button" icon="fa-folder-open-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="file_count"/></span>
                                <span class="o_stat_text">Files</span>
                            </div>
                        </button>
                        <button type="object" name="action_open_ai_feedback_tasks" class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="ai_feedback_total_count"/></span>
                                <span class="o_stat_text">AI Feedback</span>
                            </div>
                        </button>
                        <button type="object" name="action_open_ai_benchmark_logs" class="oe_stat_button" icon="fa-area-chart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="ai_benchmark_latest_accuracy"/></span>
                                <span class="o_stat_text">AI Benchmark %</span>
                            </div>
                        </button>
                        <button type="object" name="action_open_task_board" class="oe_stat_button" icon="fa-columns" string="Task Board"/>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Project name"/></h1>
                        <field name="color" widget="color_picker"/>
                    </div>

                    <group>
                        <group>
                            <field name="department_manager_id" readonly="1"/>
                            <field name="manager_id" string="Team Leader" readonly="1"/>
                            <field name="member_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="team_id" attrs="{'readonly': ['&amp;', ('id', '!=', False), ('is_department_manager_user', '=', False)]}"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                    <notebook>
                        <page string="Task Lists">
                            <button type="object" name="action_open_tasklists" string="Open Task Lists" class="btn-secondary mb-2"/>
                            <field name="tasklist_ids" context="{'default_project_id': id}">
                                <kanban class="project_nifty_list_kanban project_nifty_tasklist_kanban" quick_create="1">
                                    <field name="name"/>
                                    <field name="total_task_count"/>
                                    <field name="approved_task_count"/>
                                    <field name="progress"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click o_kanban_record project_nifty_list_card">
                                                <div class="o_kanban_record_top">
                                                    <strong><i class="fa fa-list-ul me-2" title="Task list"/> <field name="name"/></strong>
                                                </div>
                                                <div class="o_kanban_record_body">
                                                    <div class="mb-1"><span class="badge rounded-pill text-bg-success me-2"><field name="approved_task_count"/></span>Approved / <field name="total_task_count"/> Tasks</div>
                                                    <div><field name="progress" widget="progressbar"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>

                        <page string="Tasks">
                            <button type="object" name="action_open_task_board" string="Open Kanban Board" class="btn-primary mb-2"/>
                            <field name="task_ids" context="{'default_project_id': id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="tasklist_id" domain="[('project_id', '=', parent.id)]"/>
                                    <field name="assigned_ids" widget="many2many_tags" domain="[('id', 'in', parent.member_ids)]"/>
                                    <field name="deadline"/>
                                    <field name="priority"/>
                                    <field name="status" widget="badge"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Documents">
                            <button type="object" name="action_open_documents" string="Open Documents" class="btn-secondary mb-2"/>
                            <field name="document_ids" context="{'default_project_id': id}">
                                <kanban class="project_nifty_doc_kanban" quick_create="1">
                                    <field name="name"/>
                                    <field name="create_uid"/>
                                    <field name="write_uid"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click o_kanban_record project_nifty_doc_card">
                                                <div class="o_kanban_record_top">
                                                    <strong><i class="fa fa-file-text-o me-2" title="Document"/> <field name="name"/></strong>
                                                </div>
                                                <div class="o_kanban_record_body">
                                                    <div class="mb-1"><i class="fa fa-user-o me-1" title="Created by"/>Created by: <field name="create_uid"/></div>
                                                    <div><i class="fa fa-refresh me-1" title="Last updated by"/>Last updated by: <field name="write_uid"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>

                        <page string="Files">
                            <button type="object" name="action_open_files" string="Open Files" class="btn-secondary mb-2"/>
                            <field name="file_ids" context="{'default_project_id': id}">
                                <kanban class="project_nifty_file_kanban" quick_create="1">
                                    <field name="name"/>
                                    <field name="uploaded_by"/>
                                    <field name="upload_date"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click o_kanban_record project_nifty_file_card">
                                                <div class="o_kanban_record_top">
                                                    <strong><i class="fa fa-folder-open-o me-2" title="File"/> <field name="name"/></strong>
                                                </div>
                                                <div class="o_kanban_record_body">
                                                    <div class="mb-1"><i class="fa fa-user-o me-1" title="Uploaded by"/>Uploaded by: <field name="uploaded_by"/></div>
                                                    <div><i class="fa fa-calendar me-1" title="Upload date"/>Upload date: <field name="upload_date"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>

                        <page string="Members">
                            <group>
                                <field name="department_manager_id" readonly="1"/>
                                <field name="manager_id" string="Team Leader" readonly="1"/>
                                <field name="member_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </page>

                        <page string="Dashboard">
                            <div class="project_nifty_dashboard">
                                <div class="project_nifty_kpi_grid">
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">Total Tasks</span>
                                        <field name="total_task_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">Approved Tasks</span>
                                        <field name="approved_task_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">Pending Tasks</span>
                                        <field name="pending_task_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">Rejected Tasks</span>
                                        <field name="rejected_task_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">Documents</span>
                                        <field name="document_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">Files</span>
                                        <field name="file_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">Members</span>
                                        <field name="member_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">AI Acceptance Rate</span>
                                        <field name="ai_feedback_acceptance_rate" readonly="1" class="project_nifty_kpi_value" widget="percentpie"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">AI Weekly Acceptance</span>
                                        <field name="ai_feedback_week_acceptance_rate" readonly="1" class="project_nifty_kpi_value" widget="percentpie"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">AI Weekly Total</span>
                                        <field name="ai_feedback_week_total_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">AI Weekly Override</span>
                                        <field name="ai_feedback_week_override_count" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                    <div class="project_nifty_kpi_card">
                                        <span class="project_nifty_kpi_label">AI Benchmark Accuracy</span>
                                        <field name="ai_benchmark_latest_accuracy" readonly="1" class="project_nifty_kpi_value"/>
                                    </div>
                                </div>
                                <group>
                                    <group>
                                        <field name="department_manager_id" readonly="1"/>
                                        <field name="manager_id" string="Team Leader" readonly="1"/>
                                        <field name="member_count" readonly="1"/>
                                        <field name="total_task_count" readonly="1"/>
                                        <field name="approved_task_count" readonly="1"/>
                                        <field name="pending_task_count" readonly="1"/>
                                        <field name="rejected_task_count" readonly="1"/>
                                        <field name="ai_feedback_total_count" readonly="1"/>
                                        <field name="ai_feedback_accepted_count" readonly="1"/>
                                        <field name="ai_feedback_partial_count" readonly="1"/>
                                        <field name="ai_feedback_override_count" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="document_count" readonly="1"/>
                                        <field name="file_count" readonly="1"/>
                                        <field name="progress" widget="progressbar" readonly="1"/>
                                        <field name="start_date" readonly="1"/>
                                        <field name="end_date" readonly="1"/>
                                        <field name="status" readonly="1" widget="badge"/>
                                        <field name="ai_benchmark_latest_status" readonly="1" widget="badge"/>
                                        <field name="ai_feedback_acceptance_rate" readonly="1" widget="progressbar"/>
                                        <field name="ai_feedback_week_acceptance_rate" readonly="1" widget="progressbar"/>
                                    </group>
                                </group>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_project_nifty_projects" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.nifty</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_project_nifty_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
