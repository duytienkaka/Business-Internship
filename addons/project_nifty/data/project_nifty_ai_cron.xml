<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_project_nifty_ai_benchmark_monitor" model="ir.cron">
        <field name="name">Project Nifty AI Benchmark Monitor</field>
        <field name="model_id" ref="project_nifty.model_project_nifty_task"/>
        <field name="state">code</field>
        <field name="code">model.cron_ai_assignment_benchmark_monitor()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_project_nifty_task_deadline_reminder" model="ir.cron">
        <field name="name">Project Nifty Task Deadline Reminder</field>
        <field name="model_id" ref="project_nifty.model_project_nifty_task"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_deadline_reminder_emails()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_project_nifty_project_deadline_warning" model="ir.cron">
        <field name="name">Project Nifty Project Deadline Warning</field>
        <field name="model_id" ref="project_nifty.model_project_nifty"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_project_deadline_warning_emails()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
